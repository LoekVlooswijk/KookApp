    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "@types/sql.js": "^1.4.11",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.16",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "sql.js": "^1.14.1",
    "typescript": "~5.9.2"
