{
  "name": "kook-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --lan --android",
    "ios": "expo start --lan --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/slider": "^5.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "^57.0.0",
    "expo-asset": "^57.0.0",
    "expo-audio": "^57.0.0",
    "expo-constants": "^57.0.0",
    "expo-file-system": "^57.0.0",
    "expo-image-manipulator": "^57.0.0",
    "expo-image-picker": "^57.0.0",
    "expo-keep-awake": "^57.0.0",
    "expo-linking": "^57.0.0",
    "expo-router": "^57.0.0",
    "expo-secure-store": "^57.0.0",
    "expo-sqlite": "^57.0.0",
    "expo-status-bar": "^57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.84.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-safe-area-context": "~5.6.0",
